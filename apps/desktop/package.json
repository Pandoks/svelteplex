{
  "name": "@svelteplex/desktop",
  "productName": "SveltePlex",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "package": "vite build && electron-forge package",
    "make": "vite build && electron-forge make",
    "publish": "electron-forge release",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "vite build && electron-forge package && playwright test",
    "shadcn": "pnpm dlx shadcn-svelte@latest add -c ../../packages/svelte"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/electron-squirrel-startup": "1.0.2",
    "electron": "45.2.2",
    "jsdom": "30.1.3",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@svelteplex/svelte": "workspace:*",
    "electron-squirrel-startup": "1.0.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
