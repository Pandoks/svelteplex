{
  "name": "@svelteplex/svelte",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "shadcn": "pnpm dlx shadcn-svelte@latest add"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./shadcn/*": "./src/lib/components/ui/*/index.js",
    "./shadcn/css": "./src/app.css",
    "./styles/*": "./src/lib/styles/*.css"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "peerDependencies": {
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@lucide/svelte": "1.68.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/package": "3.0.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "clsx": "2.1.1",
    "jsdom": "30.1.3",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
